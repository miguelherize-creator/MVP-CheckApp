# PostgreSQL (URL completa)
DATABASE_URL=postgresql://walvy:walvy@localhost:5432/walvy

# JWT access (corto)
JWT_SECRET=cambiar-en-produccion-minimo-32-caracteres
JWT_EXPIRES_IN=15m

# Refresh opaco en BD (duración en días)
REFRESH_EXPIRES_DAYS=7

# Recuperación de contraseña
PASSWORD_RESET_EXPIRES_MINUTES=60
# Plantilla: debe incluir {{token}} o se añade ?token= al final
PASSWORD_RESET_URL_TEMPLATE=walvy://reset-password?token={{token}}

# Verificación de email — magic link (nuevo flujo)
# En producción: https://api.walvy.cl/auth/email-verification/confirm/{{token}}
# El backend valida el token y redirige al deep link de la app según APP_SCHEME
EMAIL_VERIFICATION_EXPIRES_HOURS=24
EMAIL_VERIFICATION_URL_TEMPLATE=http://localhost:3000/auth/email-verification/confirm/{{token}}

# Scheme de la app móvil (para redirección tras verificar el magic link)
APP_SCHEME=walvy

NODE_ENV=development
PORT=3000

# Solo si NODE_ENV=production y aún no hay migraciones (MVP / primer deploy). Luego poner false.
DB_SYNC=false

# Sembrar categorías/subcategorías (category.seed.json) y orígenes por usuario (funding-sources.seed.json)
SEED_CASHFLOW=false

# Orígenes web separados por coma (opcional)
CORS_ORIGIN=http://localhost:3001,http://localhost:19006

# Flow.cl — pasarela de pagos
# Sandbox: https://sandbox.flow.cl/api | Producción: https://www.flow.cl/api
FLOW_API_URL=https://sandbox.flow.cl/api
FLOW_API_KEY=tu-api-key-aqui
FLOW_SECRET_KEY=tu-secret-key-aqui
# URL que Flow llama cuando confirma el pago (debe ser pública — usa ngrok en local)
FLOW_CONFIRM_URL=https://tu-dominio.com/subscriptions/webhook
# URL a la que Flow redirige al usuario tras el pago
FLOW_RETURN_URL=https://tu-app.com/subscription/result
