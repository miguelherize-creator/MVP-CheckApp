# ── URLs ──────────────────────────────────────────────────────────────────────
HOST_FRONTEND=http://localhost:8081
HOST_BACKEND=http://localhost:3000

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://walvy:walvy@localhost:5432/walvy
DB_SYNC=false

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=localhost

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7

# ── Password reset ───────────────────────────────────────────────────────────
PASSWORD_RESET_URL_TEMPLATE=${HOST_FRONTEND}/reset-password?token={{token}}
PASSWORD_RESET_EXPIRES_MINUTES=60

# ── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Walvy <no-reply@example.com>

# ── Email — imágenes ─────────────────────────────────────────────────────────
MAIL_SUPABASE_STORAGE_SIGN_BASE=https://YOUR_PROJECT.supabase.co/storage/v1/object/sign
MAIL_MASCOT_URL=${MAIL_SUPABASE_STORAGE_SIGN_BASE}/assets/email/login.png?token=YOUR_SIGNED_TOKEN
MAIL_LOGO_URL=${MAIL_SUPABASE_STORAGE_SIGN_BASE}/assets/email/walvy-logo-horizontal-transparent.png?token=YOUR_SIGNED_TOKEN
MAIL_ISOTYPE_URL=${MAIL_SUPABASE_STORAGE_SIGN_BASE}/assets/email/logo-blur.png?token=YOUR_SIGNED_TOKEN

# ── Email — verificación ─────────────────────────────────────────────────────
EMAIL_VERIFICATION_EXPIRES_HOURS=24
EMAIL_VERIFICATION_URL_TEMPLATE=${HOST_BACKEND}/auth/email-verification/confirm/{{token}}
EMAIL_VERIFY_REDIRECT_SUCCESS_WEB=${HOST_FRONTEND}/confirm-account
EMAIL_VERIFY_REDIRECT_ERROR_WEB=${HOST_FRONTEND}/confirm-account
CONFIRM_ACCOUNT_URL=${HOST_FRONTEND}/confirm-account

# ── Seeds ──────────────────────────────────────────────────────────────────────
SEED_CASHFLOW=false

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=${HOST_FRONTEND},http://127.0.0.1:8081

# ── Flow ─────────────────────────────────────────────────────────────────────
FLOW_API_URL=https://sandbox.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_CONFIRM_URL=${HOST_BACKEND}/subscriptions/webhook
FLOW_RETURN_URL=${HOST_BACKEND}/subscriptions/return
