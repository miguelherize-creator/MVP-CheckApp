}

Table faq_articles [headercolor: #5B9BD5, note: 'L16 · Base de conocimiento · full-text search en español'] {
  id         uuid    [pk]
  slug       text    [not null, unique]
  title      text    [not null]
  body       text    [not null]
  locale     text    [not null, default: 'es']
