}

Table ai_context_snapshots [headercolor: #5B9BD5, note: 'L16 · Snapshot financiero al inicio de cada conversación · evita queries en tiempo real'] {
  id                uuid  [pk]
  conversation_id   uuid  [not null, ref: > ai_conversations.id]
  snapshot_date     date  [not null]
  financial_summary jsonb [not null]
