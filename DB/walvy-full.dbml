}

// ─────────────────────────────────────────────────────────────────
// LAYER 18 — READ MODELS CQRS  [SIN INICIAR]
// ─────────────────────────────────────────────────────────────────

Table user_month_diagnosis_summary [headercolor: #5B9BD5, note: 'L18 CQRS · Calculado por job batch · Home: semáforo, capacidad de ahorro, calidad del dato'] {
  user_id                         uuid          [not null, ref: > app_user.user_id]
  month                           date          [not null, note: 'Primer día del mes']
  computed_at                     timestamptz   [not null]
  source_watermark_at             timestamptz   [not null]
  rule_version                    varchar(50)   [not null]
  traffic_light_status            varchar(6)    [not null, note: 'green | yellow | red']
  traffic_light_reason_codes      text[]        [not null]
  visible_savings_capacity_amount decimal       [not null, default: 0]
  visible_savings_capacity_pct    decimal
  uncategorized_movements_count   int           [not null, default: 0]
  data_quality_level              varchar(6)    [not null, note: 'high | medium | low']
  data_source_mix                 varchar(8)    [not null, note: 'document | manual | both']
  next_action_type                varchar(15)   [note: 'pay | debt | budget | categorize | import']
  next_action_ref_id              uuid
  created_at                      timestamptz   [not null]
  updated_at                      timestamptz   [not null]

  indexes {
    (user_id, month) [pk]
  }
}

Table user_month_debt_priority_summary [headercolor: #5B9BD5, note: 'L18 CQRS · Calculado por job batch · Pantalla Deudas: ranking bola de nieve'] {
  user_id                  uuid    [not null, ref: > app_user.user_id]
  month                    date    [not null]
  debt_id                  uuid    [not null, ref: > debt.debt_id]
  priority_rank            int     [not null]
  priority_score           decimal [not null]
  min_payment_amount       decimal [not null, default: 0]
  estimated_payoff_date    date
  released_cashflow_amount decimal
  computed_at              timestamptz [not null]
  source_watermark_at      timestamptz [not null]
  rule_version             varchar(50) [not null]
  created_at               timestamptz [not null]
  updated_at               timestamptz [not null]

  indexes {
    (user_id, month, debt_id) [pk]
  }
}

Table user_upcoming_payments_summary [headercolor: #5B9BD5, note: 'L18 CQRS · Calculado por job batch · Home/Pagos: próximos vencimientos'] {
  user_id                uuid    [not null, ref: > app_user.user_id]
  window_start           date    [not null]
  window_end             date    [not null]
  user_payment_id        uuid    [not null, ref: > user_payment.user_payment_id]
  due_date               date    [not null]
  amount                 decimal [not null]
  user_payment_status_id bigint  [not null, ref: > status.status_id]
  computed_at            timestamptz [not null]
  source_watermark_at    timestamptz [not null]
  rule_version           varchar(50) [not null]
  created_at             timestamptz [not null]
  updated_at             timestamptz [not null]

  indexes {
    (user_id, window_start, window_end, user_payment_id) [pk]
  }
}

Table user_month_leaks_summary [headercolor: #5B9BD5, note: 'L18 CQRS · Calculado por job batch · Home: fugas del mes, gastos hormiga, top categorías'] {
  user_id             uuid    [not null, ref: > app_user.user_id]
  month               date    [not null]
  leaks_total_amount  decimal [not null, default: 0]
  leaks_count         int     [not null, default: 0]
  ant_expense_total   decimal [not null, default: 0]
  top_categories      jsonb
  computed_at         timestamptz [not null]
  source_watermark_at timestamptz [not null]
  rule_version        varchar(50) [not null]
  created_at          timestamptz [not null]
  updated_at          timestamptz [not null]

  indexes {
    (user_id, month) [pk]
  }
}
