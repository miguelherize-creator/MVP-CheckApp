}

Table report_snapshots [headercolor: #5B9BD5, note: 'L17 · Reportes pre-computados para backoffice · MRR, churn, usuarios activos'] {
  id                    uuid   [pk]
  report_type           text   [not null]
  period_start          date   [not null]
  period_end            date   [not null]
