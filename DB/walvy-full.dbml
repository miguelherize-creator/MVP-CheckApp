}

Table ai_tool_invocations [headercolor: #5B9BD5, note: 'L16 · Tool calls del asistente · debugging y auditoría'] {
  id         uuid [pk]
  message_id uuid [not null, ref: > ai_messages.id]
  tool_name  text [not null, note: 'get_monthly_summary | list_upcoming_payments']
